layout {

    focus-ring {
        active-color   "#77c6d4"
        inactive-color "#1a2223"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#77c6d4"
        inactive-color "#1a2223"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#77c6d4"
        inactive-color "#1f6c7a"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#77c6d480"
    }
}

recent-windows {
    highlight {
        active-color "#77c6d4"
        urgent-color "#fd4663"
    }
}
